# Intern onboarding module. Both are REQUIRED in production — the module
# refuses to start without them, because it handles Aadhaar data.

# Signs the admin session cookie and encrypts temporary mailbox passwords.
# Generate with: openssl rand -base64 48
# Changing it invalidates admin sessions and any password not yet collected.
ONBOARDING_SECRET=

# Shared passcode for the founders' console at /onboarding/admin.
ONBOARDING_ADMIN_PASSCODE=

# Optional. Where candidate records and Aadhaar uploads are written.
# Defaults to ./data/onboarding — must be a persistent, private volume.
# ONBOARDING_DATA_DIR=/var/lib/focusrealm/onboarding
